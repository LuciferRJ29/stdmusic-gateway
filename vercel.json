{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/config",
      "destination": "/api/config.js"
    },
    {
      "source": "/server.json",
      "destination": "/server.json"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://stdmusic-f5404e4367fe.herokuapp.com/api/$1"
    },
    {
      "source": "/static/(.*)",
      "destination": "https://stdmusic-f5404e4367fe.herokuapp.com/static/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "*"
        }
      ]
    }
  ]
}